# Composer dependencies
legacy/vendor/
legacy/composer.lock

# Node.js dependencies (desktop app)
legacy/gui/desktop/node_modules/
legacy/gui/desktop/dist/
legacy/gui/web/node_modules/
platform/node_modules/
platform/packages/*/node_modules/
platform/packages/*/dist/

