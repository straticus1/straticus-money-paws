# Build and run the @paws/api server (runs migrations on boot).
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile
RUN pnpm -r --filter '!@paws/web' build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app ./
EXPOSE 3000
CMD ["sh", "-c", "node packages/db/dist/migrate.js && node packages/db/dist/seed.js && node packages/api/dist/server.js"]
