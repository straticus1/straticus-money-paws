{
  "name": "@paws/db",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema.js",
    "./migrate": "./dist/migrate.js"
  },
  "scripts": {
    "build": "tsc -b",
